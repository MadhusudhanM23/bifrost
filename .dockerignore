# Scopes the Docker build context (docker-compose.yml uses "context: ./bifrost")
# to just the Go modules docker/bifrost.Dockerfile actually COPYs. Without this,
# the context would include the fork's >1GB .git history, ~600MB of docs, the
# Next.js dashboard, terraform, tests, etc. -- none of which bifrost-http needs.
.git
docs/
tests/
ui/
terraform/
helm-charts/
scripts/
examples/
community/
cmd/
npx/
recipes/
nix/
.github/
.claude/
.greptile/
node_modules
**/*.log

# Only transports/bifrost-http/ui matters (the //go:embed placeholder the
# Dockerfile creates); the rest of transports/ui (the dashboard app) is excluded
# above via "ui/" at the repo root -- this covers transports/ui/ too since
# "ui/" without a leading slash matches at any depth.
